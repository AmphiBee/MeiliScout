#. Plugin Name of the plugin
#: plugin.php
msgid "MeiliScout"
msgstr "MeiliScout"

#. Description of the plugin
#: plugin.php
msgid "Meilisearch integration for WordPress with a modular approach"
msgstr "Intégration de Meilisearch à WordPress, modulaire"

#. Author of the plugin
#: plugin.php
msgid "AmphiBee"
msgstr "AmphiBee"

#: plugin.php:32
msgid "MeiliScout cannot start: its dependencies are missing. Install the release zip, or run composer install."
msgstr "MeiliScout ne peut pas démarrer : ses dépendances manquent. Installez le zip de la version publiée, ou lancez composer install."

#: src/Admin/Rest/Controller.php:63
msgid "Meilisearch cannot be reached: check the connection settings."
msgstr "Meilisearch est injoignable : vérifiez les réglages de connexion."

#: src/Admin/Rest/IndexationController.php:71
msgid "An indexation is already running."
msgstr "Une indexation est déjà en cours."

#: src/Admin/Rest/IndexationController.php:115
msgid "This operation cannot be run again."
msgstr "Cette opération ne peut pas être relancée."

#: src/Admin/Rest/IndexationController.php:138
msgid "Searches still read the previous indexes."
msgstr "La recherche lit encore les anciens index."

#: src/Admin/Rest/SettingsController.php:52
msgid "The instance URL is not a valid URL."
msgstr "L'URL de l'instance n'est pas valide."

#: src/Admin/Rest/SettingsController.php:103
msgid "Enter the instance URL and the admin key."
msgstr "Saisissez l'URL de l'instance et la clé d'administration."

#: src/Foundation/Container.php:122
msgid "MeiliScout is not configured yet: set the Meilisearch host and API key in the MeiliScout settings."
msgstr "MeiliScout n'est pas encore configuré : renseignez l'URL de Meilisearch et la clé d'API dans les réglages de MeiliScout."

#: src/Foundation/Container.php:124
msgid "Unable to connect to Meilisearch. Please verify that the host and API key are correct."
msgstr "Connexion à Meilisearch impossible. Vérifiez l'URL et la clé d'API."

#: src/Foundation/Container.php:128
msgid "Unable to connect to Meilisearch. Please verify that the host and API search key are correct."
msgstr "Connexion à Meilisearch impossible. Vérifiez l'URL et la clé de recherche."

#: src/Foundation/Container.php:136
msgid "Open the settings"
msgstr "Ouvrir les réglages"

#: src/Providers/Admin/AdminServiceProvider.php:91
msgid "Loading…"
msgstr "Chargement…"

#: src/Providers/Admin/MigrationServiceProvider.php:64
msgid "The previous Meilisearch indexes were deleted."
msgstr "Les anciens index Meilisearch ont été supprimés."

#: src/Providers/Admin/MigrationServiceProvider.php:88
msgid "You are not allowed to delete these indexes."
msgstr "Vous n'avez pas le droit de supprimer ces index."

#: src/Providers/Admin/MigrationServiceProvider.php:110
msgid "MeiliScout: a full indexation is needed."
msgstr "MeiliScout : une indexation complète est nécessaire."

#. translators: 1: indexes searches read now, 2: indexes the indexation builds
#: src/Providers/Admin/MigrationServiceProvider.php:113
#, php-format
msgid "Searches keep using %1$s, in the previous format, until a full indexation builds %2$s. Content saved meanwhile is kept up to date in both."
msgstr "La recherche continue d'utiliser %1$s, dans l'ancien format, jusqu'à ce qu'une indexation complète construise %2$s. Les contenus enregistrés entre-temps restent à jour dans les deux."

#. translators: %s: indexes the indexation builds
#: src/Providers/Admin/MigrationServiceProvider.php:119
#, php-format
msgid "If your search API key is restricted to some indexes, give it access to %s first."
msgstr "Si votre clé de recherche est limitée à certains index, donnez-lui d'abord accès à %s."

#: src/Providers/Admin/MigrationServiceProvider.php:123
msgid "Go to the indexation"
msgstr "Aller à l'indexation"

#. translators: %s: indexes no longer used
#: src/Providers/Admin/MigrationServiceProvider.php:140
#, php-format
msgid "MeiliScout: searches no longer use these indexes, you can delete them: %s"
msgstr "MeiliScout : la recherche n'utilise plus ces index, vous pouvez les supprimer : %s"

#: src/Providers/Admin/MigrationServiceProvider.php:146
msgid "Delete the previous indexes"
msgstr "Supprimer les anciens index"

