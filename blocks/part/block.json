{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "meiliscout/listing-part",
	"title": "Listing part",
	"category": "theme",
	"description": "A part of the listing: search, sort, total, active filters, apply, reset.",
	"textdomain": "meiliscout",
	"ancestor": [ "meiliscout/listing" ],
	"usesContext": [ "meiliscout/listing" ],
	"attributes": {
		"part": { "type": "string", "default": "search", "enum": [ "search", "sort", "total", "active", "apply", "reset" ] }
	},
	"variations": [
		{ "name": "search", "title": "Listing search", "description": "Searches the listing's posts.", "icon": "search", "attributes": { "part": "search" }, "isDefault": true, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] },
		{ "name": "sort", "title": "Listing sort", "description": "Orders the listing's results.", "icon": "sort", "attributes": { "part": "sort" }, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] },
		{ "name": "total", "title": "Listing total", "description": "How many results match.", "icon": "editor-ol", "attributes": { "part": "total" }, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] },
		{ "name": "active", "title": "Active filters", "description": "The filters chosen, each one removable.", "icon": "dismiss", "attributes": { "part": "active" }, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] },
		{ "name": "apply", "title": "Apply filters", "description": "Sends the filters: needed without JavaScript, and in button mode.", "icon": "yes", "attributes": { "part": "apply" }, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] },
		{ "name": "reset", "title": "Reset filters", "description": "Back to the listing without filters.", "icon": "image-rotate", "attributes": { "part": "reset" }, "scope": [ "inserter", "transform" ], "isActive": [ "part" ] }
	],
	"supports": {
		"html": false,
		"color": { "text": true, "background": true },
		"typography": { "fontSize": true },
		"spacing": { "margin": true, "padding": true },
		"interactivity": { "clientNavigation": true }
	},
	"editorScript": "meiliscout-listings-editor",
	"style": "meiliscout-listings"
}
