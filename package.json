{
    "name": "meiliscout",
    "version": "2.0.0",
    "private": true,
    "scripts": {
        "build": "wp-scripts build",
        "start": "wp-scripts start",
        "format": "wp-scripts format resources/admin",
        "lint:css": "wp-scripts lint-style 'resources/admin/**/*.css'",
        "lint:js": "wp-scripts lint-js resources/admin resources/listings",
        "i18n": "wp i18n make-pot . languages/meiliscout.pot --domain=meiliscout --exclude=node_modules,vendor,tests,resources,docs --skip-audit && wp i18n update-po languages/meiliscout.pot languages && wp i18n make-mo languages && wp i18n make-json languages --no-purge",
        "packages-update": "wp-scripts packages-update",
        "test:js": "wp-scripts test-unit-js resources/listings"
    },
    "dependencies": {
        "@wordpress/api-fetch": "^7.0.0",
        "@wordpress/dom-ready": "^4.57.0",
        "@wordpress/element": "^6.0.0",
        "@wordpress/i18n": "^5.0.0",
        "@wordpress/url": "^4.0.0"
    },
    "devDependencies": {
        "@wordpress/scripts": "^31.0.0",
        "typescript": "^5.9.3"
    }
}
