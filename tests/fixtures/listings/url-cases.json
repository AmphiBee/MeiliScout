{
	"about": "UrlCodec (PHP) and resources/listings/codec.js (JS) on the listing of definition.json. Each case: the state a query string asks for, its canonical query string, and its URL; redirect, PHP only, is where UrlCodec::canonicalQuery() sends the request (null: already canonical). Cases marked accents need WordPress's remove_accents(): the unit suite leaves them to the integration suite.",
	"template": {
		"sortParam": "sort",
		"searchParam": "q",
		"defaultSort": "date",
		"sorts": {
			"date": [
				"post_date:desc"
			],
			"title": [
				"post_title_sort:asc"
			]
		},
		"facets": [
			{
				"key": "category",
				"param": "categorie",
				"type": "list",
				"logic": "or",
				"taxonomy": true,
				"decimals": 0
			},
			{
				"key": "tag",
				"param": "etiquette",
				"type": "list",
				"logic": "and",
				"taxonomy": true,
				"decimals": 0
			},
			{
				"key": "color",
				"param": "color",
				"type": "list",
				"logic": "or",
				"taxonomy": false,
				"decimals": 0
			},
			{
				"key": "price",
				"param": "price",
				"type": "range",
				"logic": "or",
				"taxonomy": false,
				"decimals": 2
			},
			{
				"key": "featured",
				"param": "featured",
				"type": "boolean",
				"logic": "or",
				"taxonomy": false,
				"decimals": 0
			}
		]
	},
	"base": "https://example.test/blog/",
	"cases": [
		{
			"name": "no parameter",
			"query": "",
			"state": {
				"values": {},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "",
			"url": "https://example.test/blog/",
			"redirect": null
		},
		{
			"name": "one term",
			"query": "categorie=news",
			"state": {
				"values": {
					"category": [
						"news"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=news",
			"url": "https://example.test/blog/?categorie=news",
			"redirect": null
		},
		{
			"name": "values sorted and unique",
			"query": "categorie=travel,news,news",
			"state": {
				"values": {
					"category": [
						"news",
						"travel"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=news,travel",
			"url": "https://example.test/blog/?categorie=news,travel",
			"redirect": "categorie=news,travel"
		},
		{
			"name": "a form repeats the name",
			"query": "categorie=travel&categorie=news",
			"state": {
				"values": {
					"category": [
						"news",
						"travel"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=news,travel",
			"url": "https://example.test/blog/?categorie=news,travel",
			"redirect": "categorie=news,travel"
		},
		{
			"name": "slugs in lowercase",
			"query": "categorie=News,TRAVEL",
			"state": {
				"values": {
					"category": [
						"news",
						"travel"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=news,travel",
			"url": "https://example.test/blog/?categorie=news,travel",
			"redirect": "categorie=news,travel"
		},
		{
			"name": "a slug sanitized as WordPress does",
			"query": "categorie=Road%20trip,big.data",
			"state": {
				"values": {
					"category": [
						"big-data",
						"road-trip"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=big-data,road-trip",
			"url": "https://example.test/blog/?categorie=big-data,road-trip",
			"redirect": "categorie=big-data,road-trip"
		},
		{
			"name": "accents removed from a slug",
			"accents": true,
			"query": "categorie=%C3%89t%C3%A9,c%C5%93ur",
			"state": {
				"values": {
					"category": [
						"coeur",
						"ete"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=coeur,ete",
			"url": "https://example.test/blog/?categorie=coeur,ete",
			"redirect": "categorie=coeur,ete"
		},
		{
			"name": "a non-Latin slug, stored encoded, written encoded",
			"query": "categorie=%D0%BF%D1%80%D0%B8",
			"state": {
				"values": {
					"category": [
						"%d0%bf%d1%80%d0%b8"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "categorie=%D0%BF%D1%80%D0%B8",
			"url": "https://example.test/blog/?categorie=%D0%BF%D1%80%D0%B8",
			"redirect": null
		},
		{
			"name": "an AND facet sorts its values too",
			"query": "etiquette=b,a",
			"state": {
				"values": {
					"tag": [
						"a",
						"b"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "etiquette=a,b",
			"url": "https://example.test/blog/?etiquette=a,b",
			"redirect": "etiquette=a,b"
		},
		{
			"name": "an encoded comma stays in its meta value",
			"query": "color=red%2Cblue,green",
			"state": {
				"values": {
					"color": [
						"green",
						"red,blue"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "color=green,red%2Cblue",
			"url": "https://example.test/blog/?color=green,red%2Cblue",
			"redirect": "color=green,red%2Cblue"
		},
		{
			"name": "a meta value keeps its case and its spaces",
			"query": "color=Light+Blue",
			"state": {
				"values": {
					"color": [
						"Light Blue"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "color=Light%20Blue",
			"url": "https://example.test/blog/?color=Light%20Blue",
			"redirect": "color=Light%20Blue"
		},
		{
			"name": "meta values in byte order: uppercase first, accents last",
			"query": "color=%C3%A9cru,blue,Blue",
			"state": {
				"values": {
					"color": [
						"Blue",
						"blue",
						"écru"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "color=Blue,blue,%C3%A9cru",
			"url": "https://example.test/blog/?color=Blue,blue,%C3%A9cru",
			"redirect": "color=Blue,blue,%C3%A9cru"
		},
		{
			"name": "byte order beyond the UTF-16 surrogates: ﬁ (U+FB01) before 🍕 (U+1F355)",
			"query": "color=%F0%9F%8D%95,%EF%AC%81",
			"state": {
				"values": {
					"color": [
						"ﬁ",
						"🍕"
					]
				},
				"ranges": {},
				"sort": "",
				"page": 1,
				"search": ""
			},
			"canonical": "color=%EF%AC%81,%F0%9F%8D%95",
			"url": "https://example.test/blog/?color=%EF%AC%81,%F0%9F%8D%95",
			"redirect": "color=%EF%AC%81,%F0%9F%8D%95"
		},
		{
			"name": "characters encodeURIComponent() leaves alone, encoded as rawurlencode() does",
			"query": "color=it's(1)!*",
			"state": {
				"values": {
					"color": [
						"it's(1)!*"
