{
    "about": "FacetPlan::counts() and results() (PHP) and resources/listings/plan.js counts() and results() (JS) on the listing of definition.json, from the template the client gets (terms' clauses as TaxQueryBuilder writes them for these ids; meta clauses and bounds checked against the builders). No base filter: the tenant token adds it. indexUid stands for the posts index.",
    "template": {
        "index": "posts",
        "perPage": 6,
        "defaultSort": "date",
        "sorts": {
            "date": [
                "post_date:desc"
            ],
            "title": [
                "post_title_sort:asc"
            ]
        },
        "fields": [
            "ID",
            "url",
            "post_title",
            "post_excerpt",
            "post_date",
            "post_type",
            "taxonomies",
            "metas.color",
            "metas.price"
        ],
        "excerptLength": 55,
        "facets": [
            {
                "key": "category",
                "type": "list",
                "logic": "or",
                "field": "taxonomies.category.tree",
                "decimals": 0,
                "values": {
                    "news": {
                        "id": "3",
                        "clause": "(taxonomies.category.tree IN [3])"
                    },
                    "travel": {
                        "id": "7",
                        "clause": "(taxonomies.category.tree IN [7])"
                    },
                    "europe": {
                        "id": "8",
                        "clause": "(taxonomies.category.tree IN [8])"
                    }
                }
            },
            {
                "key": "tag",
                "type": "list",
                "logic": "and",
                "field": "taxonomies.post_tag.term_id",
                "decimals": 0,
                "values": {
                    "a": {
                        "id": "21",
                        "clause": "(taxonomies.post_tag.slug IN ['a'])"
                    },
                    "b": {
                        "id": "22",
                        "clause": "(taxonomies.post_tag.slug IN ['b'])"
                    }
                }
            },
            {
                "key": "color",
                "type": "list",
                "logic": "or",
                "field": "metas.color",
                "decimals": 0,
                "values": {
                    "red": {
                        "id": "red",
                        "clause": "(metas.color = 'red')"
                    },
                    "green": {
                        "id": "green",
                        "clause": "(metas.color = 'green')"
                    },
                    "red,blue": {
                        "id": "red,blue",
                        "clause": "(metas.color = 'red,blue')"
                    },
                    "it's": {
                        "id": "it's",
                        "clause": "(metas.color = 'it\\'s')"
                    }
                }
            },
            {
                "key": "price",
                "type": "range",
                "logic": "or",
                "field": "metas.price",
                "decimals": 2,
                "values": {},
                "bounds": {
                    "min": "(metas.price >= {n})",
                    "max": "(metas.price <= {n})"
                }
            },
            {
                "key": "featured",
                "type": "boolean",
                "logic": "or",
                "field": "metas.featured",
                "decimals": 0,
                "values": {
                    "1": {
                        "id": "1",
                        "clause": "(metas.featured = 1)"
                    }
                }
            }
        ]
    },
    "cases": [
