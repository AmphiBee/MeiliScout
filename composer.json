{
    "name": "amphibee/meiliscout",
    "description": "Intégration de Meilisearch dans WordPress avec une approche modulaire et expressive.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "AmphiBee",
            "email": "contact@amphibee.fr"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "meilisearch/meilisearch-php": "^v1.12.0",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/http-client": "^7.3",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\MeiliScout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pollora\\MeiliScout\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test:types": "phpstan analyse --ansi",
        "test:unit": "pest --colors=always",
        "test": [
            "@test:types",
            "@test:unit"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "pestphp/pest": "^3.7",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/phpstan": "^2.1"
    }
}
